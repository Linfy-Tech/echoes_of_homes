{
  "name": "@echoes-of-home/database",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test:migrations": "node --test --test-timeout=120000 test/migrations.test.mjs",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@echoes-of-home/auth": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11"
  },
  "exports": {
    "./schema": "./src/schema.ts"
  }
}
