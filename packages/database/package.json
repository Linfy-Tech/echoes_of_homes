{
  "name": "@echoes-of-home/database",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test:audit-chain": "node --test --test-timeout=120000 test/audit-chain.test.mjs",
    "test:migrations": "node --test --test-timeout=120000 test/migrations.test.mjs",
    "test:m2-repository": "node --experimental-strip-types --test --test-timeout=120000 test/m2-repository.test.mjs",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@echoes-of-home/auth": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11"
  },
  "exports": {
    "./audit-chain": "./src/audit-chain.ts",
    "./schema": "./src/schema.ts",
    "./m2-repository": "./src/m2-repository.ts",
    "./workflow-repositories": "./src/workflow-repositories.ts"
  }
}
