# Echoes of Home — environment variable template
# PLACEHOLDER NAMES ONLY. Never put real values in this file or in source control.
# Copy to .env.local for local development. Staging/production values live in Railway variables.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=local                      # local | staging | production
LOG_LEVEL=info                     # never 'debug' in production
SERVICE_NAME=api                   # api | web | worker (set per service)

# ---- URLs / origins --------------------------------------------------------
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000   # public, non-secret
ALLOWED_ORIGINS=http://localhost:3000            # comma-separated, exact match

# ---- Database (Railway PostgreSQL in staging/prod) -------------------------
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/echoes_local
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable          # require in staging/production unless on private network (see docs)

# ---- Sessions & crypto -----------------------------------------------------
SESSION_TOKEN_PEPPER=replace-with-random-32-bytes-base64
SESSION_ABSOLUTE_TTL_HOURS=720
SESSION_IDLE_TIMEOUT_MINUTES=10080
AUDIT_HMAC_KEY=replace-with-random-32-bytes-base64
FIELD_ENCRYPTION_KEYS=replace-with-keyring-json   # {"k1":"base64key"}
FIELD_ENCRYPTION_KEY_CURRENT_ID=k1

# ---- Email (sign-in links and codes, invitations) --------------------------
EMAIL_PROVIDER=fake                # fake | <provider chosen in M1, see OPEN_QUESTIONS OQ-012>
EMAIL_FROM=no-reply@example.invalid
EMAIL_PROVIDER_API_KEY=

# ---- Media storage ---------------------------------------------------------
MEDIA_STORAGE_PROVIDER=fake        # fake | cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=             # server-side only; never exposed to the browser
CLOUDINARY_FOLDER_PREFIX=echoes/local
CLOUDINARY_NOTIFICATION_URL=http://localhost:4000/v1/webhooks/media

# ---- AI providers ----------------------------------------------------------
AI_PROVIDER_MODE=fake              # fake | live
ASR_PRIMARY_PROVIDER=fake          # fake | openai | self_hosted | google (see docs/AI_PROVIDER_STRATEGY.md)
ASR_PRIMARY_MODEL_ID=
ASR_SECONDARY_PROVIDER=            # optional, for dual-run disagreement detection
ASR_SECONDARY_MODEL_ID=
TRANSLATION_PROVIDER=fake          # fake | openai | nebius
TRANSLATION_MODEL_ID=
VERIFIER_PROVIDER=fake
VERIFIER_MODEL_ID=
CONTEXT_ASSIST_PROVIDER=fake
CONTEXT_ASSIST_MODEL_ID=

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=                   # set only if using a data-residency endpoint
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
SELF_HOSTED_ASR_URL=
SELF_HOSTED_ASR_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS_JSON=   # only if Google STT is selected after benchmark

# ---- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
JOB_DEFAULT_MAX_ATTEMPTS=5
FFMPEG_PATH=ffmpeg

# ---- Cost controls ---------------------------------------------------------
AI_DAILY_BUDGET_USD=5
AI_PER_STORY_BUDGET_USD=1
MAX_RECORDING_MINUTES=90

# ---- Rate limits -----------------------------------------------------------
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_UPLOAD_SIGN_PER_HOUR=60

# ---- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=       # Grafana Cloud EU OTLP base endpoint, supplied outside source control
GRAFANA_CLOUD_OTLP_INSTANCE_ID=    # Grafana Cloud OTLP instance ID, supplied outside source control
GRAFANA_CLOUD_OTLP_API_KEY=        # Grafana Cloud OTLP token, supplied outside source control
OTEL_SERVICE_NAME=                 # api or story-processing; set by the service runtime
ERROR_REPORTING_DSN=               # vendor chosen in M1 (OQ-013); PII scrubbing mandatory

# ---- Offsite stores (S3-compatible) ----------------------------------------
DELETION_LEDGER_S3_ENDPOINT=
DELETION_LEDGER_S3_BUCKET=
DELETION_LEDGER_S3_ACCESS_KEY_ID=
DELETION_LEDGER_S3_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=

# ---- Exports & features ----------------------------------------------------
EXPORT_LINK_TTL_HOURS=24
EXPORT_RETENTION_DAYS=7
FEATURE_PUBLIC_SHARING=false       # must stay false until Release 3 gate (docs/ROADMAP.md)
FEATURE_SECONDARY_ASR=false
