    "/v1/stories/{id}/consent": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "self_digital",
                      "assisted_verbal"
                    ]
                  },
                  "evidenceMediaAssetId": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "comprehensionResult": {
                    "type": "object",
                    "properties": {
                      "questions": {
                        "type": "number",
                        "enum": [
                          3
                        ]
                      },
                      "correct": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "reexplained": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "questions",
                      "correct",
                      "reexplained"
                    ],
                    "additionalProperties": false
                  },
                  "rightsHolderChoice": {
                    "type": "string",
                    "enum": [
                      "self",
                      "custodian"
                    ]
                  },
                  "scopes": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                },
                "required": [
                  "method",
                  "comprehensionResult",
                  "rightsHolderChoice",
                  "scopes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
