{
  "name": "@echoes-of-home/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build --pretty false",
    "test:routes": "node --experimental-strip-types --test test/routes.test.mjs",
    "test:routes:postgres": "node --experimental-strip-types --test --test-timeout=30000 test/postgres-routes.test.mjs",
    "test:openapi": "node --experimental-strip-types --test test/openapi.test.mjs",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.mjs",
    "openapi:check": "node --experimental-strip-types scripts/generate-openapi.mjs --check"
  },
  "exports": {
    "./m2-foundation": "./src/m2-foundation.ts"
  },
  "dependencies": {
    "@echoes-of-home/auth": "workspace:*",
    "@echoes-of-home/database": "workspace:*",
    "@echoes-of-home/media-storage": "workspace:*",
    "@echoes-of-home/observability": "workspace:*",
    "@echoes-of-home/validation": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-zod": "1.0.3",
    "better-auth": "1.7.16",
    "fastify": "^5.6.1",
    "graphile-worker": "0.18.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6"
  }
}
