{
  "extends": "../../tsconfig.json",
  "include": [
    "app/**/*",
    "components/**/*",
    "messages/**/*.json",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "files": [],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": [
    "node_modules"
  ]
}
