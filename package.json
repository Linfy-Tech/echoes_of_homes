{
  "name": "echoes-of-home",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "db:generate": "pnpm --filter @echoes-of-home/database db:generate",
    "db:migrate": "pnpm --filter @echoes-of-home/database db:migrate",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --no-inline-config --max-warnings 0 && node --test tests/unit/boundaries.test.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:auth-storage": "node --test --test-timeout=30000 packages/auth/test/storage.test.mjs",
    "test:audit-chain": "pnpm --filter @echoes-of-home/database test:audit-chain",
    "test:observability": "pnpm --filter @echoes-of-home/observability test",
    "test:policy": "pnpm --filter @echoes-of-home/auth test:policy",
    "test:api-routes": "pnpm --filter @echoes-of-home/api test:routes",
    "test:api-routes:postgres": "pnpm --filter @echoes-of-home/api test:routes:postgres",
    "test:openapi": "pnpm --filter @echoes-of-home/api test:openapi",
    "openapi:generate": "pnpm --filter @echoes-of-home/api openapi:generate",
    "openapi:check": "pnpm --filter @echoes-of-home/api openapi:check",
    "test:web-i18n": "pnpm --filter @echoes-of-home/web test:i18n",
    "test:database-migrations": "pnpm --filter @echoes-of-home/database test:migrations",
    "eval:asr": "node scripts/asr-eval.mjs",
    "test:asr-pipeline": "pnpm --filter @echoes-of-home/ai-providers test && pnpm --filter @echoes-of-home/story-processing test"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "railway": "3.16.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
